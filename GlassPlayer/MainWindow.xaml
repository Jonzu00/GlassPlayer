<Window x:Class="GlassPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Glass" Width="1020" Height="660" MinWidth="860" MinHeight="580"
        WindowStyle="None" Background="Transparent" Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Blob1T" Storyboard.TargetProperty="X" To="110" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Blob1T" Storyboard.TargetProperty="Y" To="80" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Blob2T" Storyboard.TargetProperty="X" To="-120" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Blob2T" Storyboard.TargetProperty="Y" To="-70" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2CFFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8CFFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset=".5"/>
            <GradientStop Color="#4DFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Background" Value="{StaticResource GlassFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity=".28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Round" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="999" Background="Transparent" RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Light" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="13" Height="13" Fill="{TemplateBinding Background}" Margin="0,0,8,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="14" Padding="16,6" Background="#00FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color" To="#47FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color" To="#00FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Search" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="16" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Opacity=".6" Margin="0,2,10,0"/>
                                <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Opacity=".45" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="16" Padding="8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#17FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Rail" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Seek" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="5" CornerRadius="3" Background="#38FFFFFF"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Rail}" Background="White"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity=".4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Rail}" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value=".55"/>
            <Setter Property="Margin" Value="0,18,0,4"/>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14" Padding="16,7" Background="#2EFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#47FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="48" Height="29" CornerRadius="15" Background="#3DFFFFFF">
                            <Ellipse Width="23" Height="23" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="knob"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity=".35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="X" To="19" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="Background.Color" To="#34C759" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="Background.Color" To="#3DFFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Ambient" IsHitTestVisible="False">
            <Ellipse Width="780" Height="780" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-360,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A05E5CE6" Offset="0"/>
                        <GradientStop Color="#005E5CE6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Blob1T"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="740" Height="740" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-340">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99FF375F" Offset="0"/>
                        <GradientStop Color="#00FF375F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Blob2T"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Image x:Name="Glow" Stretch="UniformToFill" Opacity="0">
                <Image.Effect>
                    <BlurEffect Radius="110"/>
                </Image.Effect>
            </Image>
        </Grid>

        <Grid x:Name="Root" Opacity="0" RenderTransformOrigin=".5,.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX=".95" ScaleY=".95"/>
            </Grid.RenderTransform>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Light}" Background="#FF5F57" Click="Close_Click"/>
                <Button Style="{StaticResource Light}" Background="#FEBC2E" Click="Min_Click"/>
                <Button Style="{StaticResource Light}" Background="#28C840" Click="Max_Click"/>
            </StackPanel>
            <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="15" Content="&#xE713;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True" Click="Settings_Click"/>
            <Border CornerRadius="18" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="3" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SoundCloudBtn" Style="{StaticResource Pill}" Content="SoundCloud" Tag="SoundCloud" Checked="Provider_Checked"/>
                    <RadioButton x:Name="SpotifyBtn" Style="{StaticResource Pill}" Content="Spotify" Tag="Spotify" Checked="Provider_Checked"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Glass}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Tag="Songs, artists" KeyDown="Search_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource Action}" Content="Import" Margin="8,0,0,0" Click="Import_Click"/>
                        </Grid>
                        <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="List_PreviewMouseWheel" SelectionChanged="List_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="11">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Opacity=".6" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Opacity=".5" VerticalAlignment="Center" Margin="10,0,2,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="Status" Grid.Row="3" Text="Search for a song or artist." Opacity=".6" TextWrapping="Wrap" Margin="4,8,4,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="40,24">
                    <StackPanel VerticalAlignment="Center" MaxWidth="420">
                        <Border x:Name="ArtBox" Width="280" Height="280" CornerRadius="30" Margin="0,0,0,26" RenderTransformOrigin=".5,.5">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity=".4"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ArtScale" ScaleX=".88" ScaleY=".88"/>
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Text="Pick a track from the list" FontSize="16" Opacity=".6" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,22"/>
                        <Slider x:Name="Seek" Style="{StaticResource Seek}" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" ValueChanged="Seek_ValueChanged"/>
                        <Grid Margin="0,2,0,10">
                            <TextBlock x:Name="Cur" Text="0:00" FontSize="12" Opacity=".6"/>
                            <TextBlock x:Name="Dur" Text="0:00" FontSize="12" Opacity=".6" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource Round}" Width="52" Height="52" FontSize="20" Content="&#xE892;" Click="Prev_Click"/>
                            <Button x:Name="PlayBtn" Style="{StaticResource Round}" Width="68" Height="68" FontSize="28" Content="&#xE768;" Margin="14,0" Click="PlayPause_Click"/>
                            <Button Style="{StaticResource Round}" Width="52" Height="52" FontSize="20" Content="&#xE893;" Click="Next_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Opacity=".6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider x:Name="Volume" Style="{StaticResource Seek}" IsMoveToPointEnabled="True" Width="140" Minimum="0" Maximum="1" Value=".8" ValueChanged="Volume_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="Overlay" Margin="0,48,0,0" Visibility="Collapsed">
            <Border x:Name="Dim" Background="#59000000" Opacity="0" MouseLeftButtonDown="Dim_Click"/>
            <Border x:Name="Sheet" Style="{StaticResource Glass}" Background="#E01E1E28" Margin="16,0,16,16" Padding="32,26" Opacity="0" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SheetScale" ScaleX=".94" ScaleY=".94"/>
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel MaxWidth="560">
                        <Grid>
                            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE711;" HorizontalAlignment="Right" Click="CloseSettings_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="Accounts"/>
                        <Border CornerRadius="18" Background="#14FFFFFF" Padding="14" Margin="0,4,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="24" Background="#26FFFFFF"/>
                                    <Border CornerRadius="24">
                                        <Border.Background>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock x:Name="AvatarInitial" Text="S" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpotifyName" Text="Spotify" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SpotifyDetail" Text="" FontSize="12" Opacity=".6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="SpotifyAction" Grid.Column="2" Style="{StaticResource Action}" Content="Connect" VerticalAlignment="Center" Click="SpotifyAction_Click"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="18" Background="#14FFFFFF" Padding="14">
                            <StackPanel>
                                <TextBlock Text="YouTube Music and SoundCloud" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SoundCloudDetail" FontSize="12" Opacity=".6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="Playback"/>
                        <Grid Margin="0,6,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                                <TextBlock Text="Autoplay next track" FontSize="14"/>
                                <TextBlock Text="Move on to the next result when a song ends" FontSize="12" Opacity=".55" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="AutoplayToggle" Tag="Autoplay" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Click"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                                <TextBlock Text="Open Spotify when needed" FontSize="14"/>
                                <TextBlock Text="Start the Spotify app if it isn't running" FontSize="12" Opacity=".55" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="LaunchToggle" Tag="Launch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Click"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                                <TextBlock Text="Remember volume" FontSize="14"/>
                                <TextBlock Text="Start at the level you left it on" FontSize="12" Opacity=".55" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="VolumeToggle" Tag="Volume" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="Appearance"/>
                        <Grid Margin="0,6,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                                <TextBlock Text="Ambient glow" FontSize="14"/>
                                <TextBlock Text="Blur the cover art into the background" FontSize="12" Opacity=".55" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="GlowToggle" Tag="Glow" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Setting_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="ImportOverlay" Margin="0,48,0,0" Visibility="Collapsed">
            <Border Background="#59000000" MouseLeftButtonDown="ImportDim_Click"/>
            <Border x:Name="ImportCard" Style="{StaticResource Glass}" Background="#E61E1E28" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24" Opacity="0" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ImportScale" ScaleX=".94" ScaleY=".94"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="Import" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Paste a playlist or song link from YouTube, YouTube Music, SoundCloud or Spotify, or pick audio files from this PC." FontSize="13" Opacity=".6" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <TextBox x:Name="ImportBox" Style="{StaticResource Search}" Tag="Paste a link" KeyDown="Import_KeyDown"/>
                    <Grid Margin="0,14,0,0">
                        <Button Style="{StaticResource Action}" Content="Choose files…" HorizontalAlignment="Left" Click="ImportFiles_Click"/>
                        <Button x:Name="ImportGo" Style="{StaticResource Action}" Content="Import link" HorizontalAlignment="Right" Click="ImportGo_Click"/>
                    </Grid>
                    <TextBlock x:Name="ImportStatus" FontSize="12" Opacity=".75" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <wv2:WebView2 x:Name="Web" Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
    </Grid>
</Window>
